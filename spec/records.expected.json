{
  "suite": "records_expected",
  "suite_version": "1.0",
  "depends_on": "grouping_cases.json",
  "description": "Kết quả mong đợi sau khi chuẩn hóa (MESSAGE_GROUP → RECORD), cùng case_id với grouping_cases.json. Confidence được chấm cho từng quyết định suy luận, không chỉ cho trường OCR, để một số tiền đọc rất chắc không làm cả giao dịch trông chắc theo.",
  "confidence_bands": {
    "HIGH": "confidence ≥ 0.90",
    "MEDIUM": "0.60 ≤ confidence < 0.90",
    "LOW": "confidence < 0.60",
    "NONE": "không có giá trị (value = null)"
  },
  "conventions": {
    "decisions": "Mỗi quyết định có value và danh sách band được chấp nhận. value = null nghĩa là hệ thống không được tự chọn; candidates liệt kê các giá trị cần đưa cho kế toán.",
    "review_required": "true khi message_group, transaction_type, amount hoặc posting_date không đạt HIGH hay có value null, hoặc khi bản ghi là đính chính. document_date = null không bắt buộc duyệt vì nhiều chứng từ và số tự khai vốn không có ngày. null ở trường này nghĩa là ca không kiểm tra cờ đó.",
    "sent_date": "Ngày gửi theo giờ địa phương, tất định, không có confidence. null với tin nhập tay không có giờ gửi.",
    "posting_date": "Ngày hạch toán đề xuất, đã áp giờ chốt ngày kinh doanh.",
    "evidence_kind": "document | bank_transfer_screenshot | self_declared. self_declared là số tự khai, không phải chứng từ (nguyên tắc G6).",
    "record_count": "Số nguyên, hoặc {min, max} khi cách chia nhóm là AMBIGUOUS.",
    "constraints": "Điều kiện áp cho mọi bản ghi sinh ra từ các item đã nêu, dùng khi không thể cố định bản ghi.",
    "expected_matches": "MATCH đề xuất kèm bằng chứng từng tiêu chí, dùng để hiển thị lý do ghép cho kế toán."
  },
